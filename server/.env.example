# העתיקי את הקובץ הזה לקובץ חדש בשם .env ומלאי את הערכים.
# הקובץ .env לא עולה ל-GitHub (הוא מופיע ב-.gitignore). לא משתפים אותו עם אף אחד.

# פורט מקומי. ב-Render הפורט נקבע אוטומטית.
PORT=4000

# development מקומית, production ב-Render
NODE_ENV=development

# כתובת החיבור למסד הנתונים מ-Neon (Connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# מסד נתונים נפרד לבדיקות האוטומטיות (ענף נוסף ב-Neon). הבדיקות מוחקות בו את כל הנתונים!
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME_TEST?sslmode=require"

# מחרוזת סודית אקראית, לפחות 32 תווים. משמשת לחתימת טוקני ההתחברות.
JWT_SECRET="change-me-to-a-long-random-string-of-at-least-32-characters"

# תוקף הטוקן בשניות (604800 = 7 ימים)
JWT_EXPIRES_IN_SECONDS=604800

# שלושת הפרטים מ-Cloudinary (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# הכתובות שמותר להן לפנות לשרת מהדפדפן, מופרדות בפסיק
CORS_ORIGINS="http://localhost:5173"

# סיסמה למשתמשי ההדגמה שה-seed יוצר. בלי הערך הזה ה-seed לא ירוץ.
SEED_PASSWORD=""
